{
  "openapi": "3.1.0",
  "info": {
    "title": "Exsim exchange management",
    "version": "1.0.0",
    "description": "Manage empty exchange processes. Traders connect directly using the returned TCP/UDP endpoints."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7600"
    }
  ],
  "paths": {
    "/v1/service": {
      "get": {
        "operationId": "getService",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "product",
                    "apiVersion",
                    "profile",
                    "orderEntryProtocols",
                    "marketDataProtocols"
                  ],
                  "properties": {
                    "product": {
                      "const": "exsim"
                    },
                    "apiVersion": {
                      "const": "v1"
                    },
                    "profile": {
                      "const": "ouch42_soupbintcp_itch50_moldudp64"
                    },
                    "orderEntryProtocols": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "ouch42_soupbintcp",
                          "fix44",
                          "ilink3"
                        ]
                      },
                      "minItems": 2,
                      "uniqueItems": true
                    },
                    "marketDataProtocols": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "itch50_moldudp64",
                          "mdp3_sbe"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exchanges": {
      "get": {
        "operationId": "listExchanges",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Exchange"
                  }
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createExchange",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "config"
                ],
                "properties": {
                  "config": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Full INI as in test/fixtures/exchange.conf, including credentials. OUCH 4.2 and FIX 4.4 users are supported. Use a specific unicast IPv4 bind address and a nonzero UDP feed destination port. Listener port zero means OS-assigned. Bots, public admin, and FIXP are rejected. Optional [journal] settings are supported; path must be a file name ending in .journal."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/exchanges/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getExchange",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "replaceExchangeConfig",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "config"
                ],
                "properties": {
                  "config": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Full INI as in test/fixtures/exchange.conf, including credentials. OUCH 4.2 and FIX 4.4 users are supported. Use a specific unicast IPv4 bind address and a nonzero UDP feed destination port. Listener port zero means OS-assigned. Bots, public admin, and FIXP are rejected. Optional [journal] settings are supported; path must be a file name ending in .journal."
                  }
                }
              }
            }
          }
        },
        "description": "Requires a stopped or exited instance. Full credentials must be resubmitted; [REDACTED] cannot be used as input."
      },
      "delete": {
        "operationId": "deleteExchange",
        "responses": {
          "204": {
            "description": "Definition deleted"
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Requires a stopped or exited instance; never implicitly stops a running instance."
      }
    },
    "/v1/exchanges/{id}/start": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "startExchange",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Waits for socket readiness. Repeated start returns the existing process. Startup failures roll back sockets and return 409; executable launch failure returns 503."
      }
    },
    "/v1/exchanges/{id}/stop": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "stopExchange",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Waits for graceful shutdown and bounded forced termination. Repeated stop is harmless."
      }
    },
    "/v1/exchanges/{id}/status": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getExchangeStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Exchange"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exchanges/{id}/connections": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "getExchangeConnections",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Connections"
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/exchanges/{id}/admin": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "operationId": "adminExchange",
        "description": "Execute one existing admin text command on the exchange reactor thread. Supports help, status, book, phase, fault md, fault user and shutdown. Requires a running exchange. An admin error returns 400 with a reply string ending in ERR <message>; input errors use Error. Commands are not persisted across restarts.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "command"
                ],
                "properties": {
                  "command": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096,
                    "description": "One command line, at most 4096 UTF-8 bytes, without CR, LF or NUL. Example: phase AAPL continuous",
                    "pattern": "^[^\\r\\n\\u0000]+$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Command applied. Reply ends with OK followed by a newline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminReply"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or admin command failure.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "$ref": "#/components/schemas/AdminReply"
                    },
                    {
                      "$ref": "#/components/schemas/Error"
                    }
                  ]
                }
              }
            }
          },
          "default": {
            "description": "400 invalid input; 404 unknown route/ID; 405 unsupported collection/item method; 409 state/port/feed conflict; 500 internal error; 503 process unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Exchange": {
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "pid",
          "error",
          "config",
          "runtime"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "enum": [
              "stopped",
              "running",
              "failed"
            ]
          },
          "pid": {
            "type": [
              "integer",
              "null"
            ]
          },
          "error": {
            "type": "string"
          },
          "config": {
            "type": "string",
            "description": "Saved INI with password, replay_password and ilink_secret_key values replaced by [REDACTED]."
          },
          "runtime": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Runtime"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Runtime": {
        "type": "object",
        "required": [
          "state",
          "liveOrders",
          "commandsApplied",
          "connections"
        ],
        "properties": {
          "state": {
            "enum": [
              "running",
              "stopping"
            ]
          },
          "liveOrders": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "commandsApplied": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "connections": {
            "$ref": "#/components/schemas/Connections"
          }
        }
      },
      "Connections": {
        "type": "object",
        "required": [
          "address",
          "orderEntryProtocol",
          "orderEntryPort",
          "marketDataProtocol",
          "marketDataAddress",
          "marketDataPort",
          "recoveryPort",
          "session",
          "fixOrderEntryPort",
          "recoveryTransport",
          "snapshotPort",
          "instrumentReplayPort",
          "backupMarketDataPort",
          "channelId",
          "ilinkOrderEntryPort"
        ],
        "properties": {
          "address": {
            "type": "string",
            "format": "ipv4"
          },
          "orderEntryProtocol": {
            "const": "ouch42_soupbintcp"
          },
          "orderEntryPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "marketDataProtocol": {
            "type": "string",
            "enum": [
              "itch50_moldudp64",
              "mdp3_sbe"
            ]
          },
          "marketDataAddress": {
            "type": "string",
            "format": "ipv4"
          },
          "marketDataPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "recoveryPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "session": {
            "type": "string",
            "maxLength": 10
          },
          "fixOrderEntryPort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "FIX 4.4 TCP listener; authenticates users configured with protocol=fix44."
          },
          "recoveryTransport": {
            "type": "string",
            "enum": [
              "udp",
              "tcp"
            ]
          },
          "snapshotPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "MDP snapshot UDP destination port; zero for ITCH."
          },
          "instrumentReplayPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "MDP instrument definition UDP destination port; zero for ITCH."
          },
          "backupMarketDataPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "Optional MDP redundant incremental UDP destination port."
          },
          "channelId": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32767
          },
          "ilinkOrderEntryPort": {
            "type": "integer",
            "minimum": 0,
            "maximum": 65535,
            "description": "CME iLink 3 schema 8/version 9 TCP listener; zero when no iLink users or explicit listener are configured."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "AdminReply": {
        "type": "object",
        "required": [
          "reply"
        ],
        "properties": {
          "reply": {
            "type": "string",
            "description": "Existing newline-terminated admin text reply, ending with OK or ERR <message>."
          }
        }
      }
    }
  }
}
